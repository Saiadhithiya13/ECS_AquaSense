# ─────────────────────────────────────────────────────────────────
# AquaSense Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ThingSpeak READ key for your channel.
# Leave empty if the channel is public.
# Do NOT put the ESP32 WRITE key here.
THINGSPEAK_CHANNEL_ID=178785
THINGSPEAK_READ_API_KEY=YOUR_READ_API_KEY_HERE

# Comma-separated list of origins the backend will accept for CORS.
# Add your production frontend URL here when deploying.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Polling interval in seconds (default: 20)
REFRESH_SECONDS=20

# Number of historical records to fetch from ThingSpeak (default: 100)
HISTORY_COUNT=100

# Number of synthetic training samples (default: 6000)
TRAINING_SAMPLES=6000

# Port the Flask server listens on (default: 5000)
PORT=5000

# Water quality thresholds (must match ESP32 firmware constants)
PH_LOW=5.5
PH_HIGH=8.5
TURBIDITY_LIMIT=12.0
EC_LIMIT=800.0
